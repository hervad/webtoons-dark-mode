{
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "eslint.validate": ["javascript"],
    "eslint.experimental.useFlatConfig": true,
    "files.eol": "\n",
    "files.exclude": {
        "**/node_modules": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "node_modules": true,
        "package-lock.json": true,
        "scripts/cache": true
    }
}
